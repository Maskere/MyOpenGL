#############################################
# Utility command for edit_cache

build _deps/assimp-build/code/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Users\Mus\Programmering\OpenGL\build\_deps\assimp-build\code && "C:\Program Files\CMake\bin\cmake-gui.exe" -SC:\Users\Mus\Programmering\OpenGL -BC:\Users\Mus\Programmering\OpenGL\build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build _deps/assimp-build/code/edit_cache: phony _deps/assimp-build/code/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build _deps/assimp-build/code/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Users\Mus\Programmering\OpenGL\build\_deps\assimp-build\code && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SC:\Users\Mus\Programmering\OpenGL -BC:\Users\Mus\Programmering\OpenGL\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build _deps/assimp-build/code/rebuild_cache: phony _deps/assimp-build/code/CMakeFiles/rebuild_cache.util

